---
import { site } from '../site.config';
import { footerBlurb } from '../data/copy';
const b = site.business;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <img src="/logo-white.svg" alt={b.name} width="160" height="48" />
      <p>{footerBlurb}</p>
    </div>
    <div>
      <p class="strong">Explore</p>
      <ul>{site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <p class="strong">Company</p>
      <ul>
        {site.footerNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {b.sameAs.map((u) => <li><a href={u} rel="noopener">{new URL(u).hostname.replace(/^www\./, '')}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>&copy; {year} {b.name}</p>
    {site.builtBy && <p><a href={site.builtBy.href} rel="noopener">{site.builtBy.label}</a></p>}
  </div>
</footer>
