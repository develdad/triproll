---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import Photo from '../components/Photo.astro';
import { photos } from '../lib/photos';
import { howItWorks as c } from '../data/copy';

const stepPhotos = ['market-produce', 'traveler-suitcase', 'wing-window', 'lagoon-aerial'] as const;
const stepSizes = '(min-width: 70rem) 16rem, (min-width: 40rem) 45vw, calc(100vw - 2.5rem)';
const stepWidths = [360, 560, 800];
const stepQuality = 42; // phones render these cards at about 3x density, so a lower quality is not visible
// Preload the first card photo (the LCP element) with the same candidates the <picture> uses.
const lcp = await Promise.all(stepWidths.map((w) => getImage({ src: photos[stepPhotos[0]], width: w, format: 'avif', quality: stepQuality })));
const lcpSrcset = lcp.map((i, k) => `${i.src} ${stepWidths[k]}w`).join(', ');
---

<Base title={c.title} description={c.description} crumbs={[{ name: 'Home', path: '/' }, { name: 'How it works', path: '/how-it-works' }]}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={lcpSrcset} imagesizes={stepSizes} fetchpriority="high" />
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / How it works</p>
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <ol class="step-cards">
        {c.stepCards.map((s, i) => (
          <li class="reveal">
            <div class="step-img">
              <Photo name={stepPhotos[i]} sizes={stepSizes} widths={stepWidths} quality={stepQuality} eager={i === 0} decorative />
              <span class="step-no" aria-hidden="true">{i + 1}</span>
            </div>
            <div class="step-body"><h2>{s.title}</h2><p>{s.body}</p></div>
          </li>
        ))}
      </ol>
      <ul class="toc">
        {c.sections.map((s) => <li><a href={`#${s.id}`}>{s.h}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="defer section" style="border-top:1px solid var(--rule)">
    <div class="wrap narrow prose">
      {c.sections.map((s) => (
        <>
          <h2 id={s.id}>{s.h}</h2>
          {s.paras.map((p) => <p>{p}</p>)}
        </>
      ))}
    </div>
  </section>
  <section class="defer section on-ink">
    <div class="wrap">
      <h2>{c.ctaTitle}</h2>
      <p class="lead" style="margin-top:1rem">{c.ctaBody}</p>
      <div class="actions">
        <a class="btn" href="/roll">Roll a trip</a>
        <a class="btn ghost" href="/travel-dna">Find your Travel DNA</a>
      </div>
    </div>
  </section>
</Base>
