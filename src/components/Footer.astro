---
import { site } from '../site.config';
import { footerBlurb } from '../data/copy';
import Icon from './Icon.astro';
const b = site.business;
const year = new Date().getFullYear();
const cta = site.nav[0];
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <picture>
        <source type="image/webp" srcset="/brand/logo-light-1x.webp 1x, /brand/logo-light-2x.webp 2x" />
        <img src="/brand/logo-light-1x.png" srcset="/brand/logo-light-2x.png 2x" alt={b.name} width="168" height="43" loading="lazy" decoding="async" />
      </picture>
      <p>{b.tagline}</p>
      <a class="btn sm foot-cta" href={cta.href}>{cta.label}<Icon name="arrow" size={18} /></a>
    </div>
    <div>
      <p class="strong">Explore</p>
      <ul>{site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <p class="strong">Company</p>
      <ul>
        {site.footerNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {b.sameAs.map((u) => <li><a href={u} rel="noopener">{new URL(u).hostname.replace(/^www\./, '')}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="strong">Beta</p>
      <div class="foot-note"><Icon name="shield" size={18} /><span>{footerBlurb}</span></div>
    </div>
  </div>
  <div class="wrap legal">
    <p>&copy; {year} {b.name}</p>
    {site.builtBy && <p><a href={site.builtBy.href} rel="noopener">{site.builtBy.label}</a></p>}
  </div>
</footer>
