---
import { ICONS, type IconName } from '../lib/icons';
const { name, size = 20, class: cls = '' } = Astro.props as { name: IconName; size?: number; class?: string };
---

<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[name]} />
