---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Roll from '../components/islands/Roll.tsx';
import FormDefs from '../components/FormDefs.astro';
import NoscriptWaitlist from '../components/NoscriptWaitlist.astro';
import globePoster from '../assets/globe-poster.webp';
import { photos } from '../lib/photos';
import { MOODS, MOOD_PHOTO, PHOTO_ALT, type Mood } from '../data/photos';
import { rollPage as c } from '../data/copy';

// Mood photos for the itinerary card header, one per climate mood. Never keyed by destination.
const entries = await Promise.all(
  MOODS.map(async (m) => {
    const key = MOOD_PHOTO[m];
    const img = await getImage({ src: photos[key], width: 900, format: 'webp', quality: 70 });
    return [m, { src: img.src, alt: PHOTO_ALT[key], width: img.attributes.width as number, height: img.attributes.height as number }] as const;
  }),
);
const posterImg = await getImage({ src: globePoster, width: 900, format: 'webp', quality: 70 });
const poster = { src: posterImg.src, width: posterImg.attributes.width as number, height: posterImg.attributes.height as number };
const moods = Object.fromEntries(entries) as Record<Mood, { src: string; alt: string; width: number; height: number }>;
---

<Base title={c.title} description={c.description} crumbs={[{ name: 'Home', path: '/' }, { name: 'Roll a trip', path: '/roll' }]}>
  <noscript slot="head"><style>.js-only{display:none}</style></noscript>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Roll a trip</p>
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>
  <section class="section" style="border-top:1px solid var(--rule);padding-block:3rem 1rem">
    <div class="wrap roll-wrap">
      <div class="js-only"><Roll client:load moods={moods} poster={poster} /></div>
      <NoscriptWaitlist source="roll:nojs" intro={c.noscript} />
    </div>
  </section>
  <section class="section">
    <div class="wrap narrow prose">
      <h2>{c.below.title}</h2>
      <ol class="steps-list">{c.below.steps.map((st) => <li><strong>{st.title}</strong> {st.body}</li>)}</ol>
      {c.below.body.map((p) => <p>{p}</p>)}
      <p><a href="/how-it-works#pricing">How pricing and review work</a> and <a href="/faq">the FAQ</a> have the detail.</p>
    </div>
  </section>
  <FormDefs names={['trip-request', 'waitlist']} />
</Base>
