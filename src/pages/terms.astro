---
import Base from '../layouts/Base.astro';
import { terms as c } from '../data/copy';
---

<Base title={c.title} description={c.description} crumbs={[{ name: 'Home', path: '/' }, { name: 'Terms', path: '/terms' }]}>
  <Fragment set:html="<!-- DRAFT: needs owner review before launch -->" />
  <section class="page-head">
    <div class="wrap narrow">
      <p class="crumbs"><a href="/">Home</a> / Terms</p>
      <h1>{c.h1}</h1>
      <p class="lead">Plain-language draft. It will be reviewed before launch.</p>
    </div>
  </section>
  <section class="section" style="border-top:1px solid var(--rule)">
    <div class="wrap narrow prose">
      {c.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.body.map((p) => <p>{p}</p>)}
        </>
      ))}
    </div>
  </section>
</Base>
