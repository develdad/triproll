---
import Base from '../layouts/Base.astro';
import Quiz from '../components/islands/Quiz.tsx';
import FormDefs from '../components/FormDefs.astro';
import NoscriptWaitlist from '../components/NoscriptWaitlist.astro';
import Photo from '../components/Photo.astro';
import { travelDna as c } from '../data/copy';
import { archetypes } from '../data/quiz';
---

<Base title={c.title} description={c.description} crumbs={[{ name: 'Home', path: '/' }, { name: 'Travel DNA', path: '/travel-dna' }]}>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Travel DNA</p>
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="head-photo"><Photo name="city-dusk" sizes="(min-width: 72rem) 68rem, 100vw" widths={[640, 1000, 1600, 2000]} eager position="50% 55%" /></div>
    </div>
  </section>
  <section class="section" style="border-top:1px solid var(--rule)">
    <div class="wrap">
      <Quiz client:load />
      <NoscriptWaitlist source="travel-dna:nojs" intro="The quiz needs JavaScript. Leave your email and we will tell you when it is available without it." />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What it measures</span>
        <h2>{c.axesTitle}</h2>
      </div>
      <ul class="plain-rows">
        {c.axes.map((a) => <li><h3>{a.name}</h3><p>{a.body}</p></li>)}
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Where you land</span>
        <h2>{c.archetypesTitle}</h2>
        <p class="lead">{c.archetypesLead}</p>
      </div>
      <ul class="arch-list">
        {archetypes.map((a) => <li><h3>{a.name}</h3><p>{a.tagline} {a.description}</p></li>)}
      </ul>
      <p class="hint" style="margin-top:1.5rem">{c.privacyNote}</p>
    </div>
  </section>
  <FormDefs names={['waitlist']} />
</Base>
