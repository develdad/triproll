---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../site.config';
const current = Astro.url.pathname.replace(/\.html$/, '') || '/';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${site.business.name} home`}>
      <Image src={logo} alt={site.business.name} width={117} height={30} densities={[1, 2, 3]} loading="eager" />
    </a>
    <nav aria-label="Primary" class="nav">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
